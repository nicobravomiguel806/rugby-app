<?xml version="1.0" encoding="utf-8"?>
<!-- SP-04 · CA-2 / AT-17 (Android 12+): nada de la app viaja en el respaldo en la nube ni en la transferencia a otro
     equipo: ni la sesión cifrada (DataStore), ni el keyset de Tink (shared_prefs), ni la base local. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
