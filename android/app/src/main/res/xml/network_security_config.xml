<?xml version="1.0" encoding="utf-8"?>
<!-- AT-12 (MITM): solo HTTPS y solo con las CA del sistema. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
