{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./scripts/verificar.sh:*)",
      "Bash(./scripts/architecture-guard.sh:*)",
      "Bash(./backend/scripts/run-db-tests.sh:*)",
      "Bash(swift test:*)",
      "Bash(swift build:*)",
      "Bash(gradle:*)",
      "Bash(./gradlew:*)",
      "Bash(xcodebuild:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run view:*)"
    ],
    "ask": [
      "Bash(gh pr merge:*)",
      "Bash(supabase db push:*)",
      "Bash(supabase link:*)",
      "Bash(git push --force-with-lease:*)"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force origin:*)",
      "Bash(gh pr merge --admin:*)",
      "Bash(supabase db reset --linked:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./ios/**/Secrets.xcconfig)"
    ]
  }
}
