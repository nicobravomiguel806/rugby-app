// Plantilla de llaves locales. Copia este archivo a Secrets.xcconfig (ignorado por git) y llena los valores.
// La app solo usa la llave anon/publishable; la service_role nunca va aquí (SP-04, ADR 0006).
// En un xcconfig, `//` inicia un comentario: escribe la URL como https:/$()/<proyecto>.supabase.co
SUPABASE_URL =
SUPABASE_ANON_KEY =

// Clientes OAuth de Google (Google Cloud). El Web es el que valida Supabase; el iOS es el de la app.
GOOGLE_WEB_CLIENT_ID =
GOOGLE_IOS_CLIENT_ID =
// «iOS URL scheme» de Google Cloud: el client id iOS invertido, com.googleusercontent.apps.<client id iOS>
GOOGLE_IOS_URL_SCHEME =
